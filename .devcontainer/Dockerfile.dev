# syntax=docker/dockerfile:1
# Dev DevContainer - Python + Node.js + Bun development environment
# Target: < 1.5GB, < 5 min build time

# Base image with pinned digest for reproducibility
FROM debian:bookworm-slim@sha256:56ff6d36d4eb3db13a741b342ec466f121480b5edded42e4b7ee850ce7a418ee

# Build arguments
ARG USERNAME=node
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# Environment
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=ja_JP.UTF-8
ENV LANGUAGE=ja_JP:ja
ENV LC_ALL=ja_JP.UTF-8
ENV TERM=xterm-256color
ENV PATH="/home/node/.local/bin:/home/node/.bun/bin:${PATH}"

# Labels
LABEL maintainer="ykm2006"
LABEL description="Dev DevContainer with Python, Node.js, and Bun"
LABEL version="1.0"

# =============================================================================
# System Packages (Base)
# =============================================================================

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    wget \
    jq \
    vim \
    nano \
    less \
    procps \
    sudo \
    unzip \
    ca-certificates \
    gnupg2 \
    locales \
    zsh \
    && rm -rf /var/lib/apt/lists/*

# Configure locales
RUN sed -i '/ja_JP.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# =============================================================================
# System Packages (Dev Tools)
# =============================================================================

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    # Python 3.11 (#29)
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    # Network tools (#32)
    iproute2 \
    dnsutils \
    # Shell linter (#33)
    shellcheck \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# GitHub CLI
# =============================================================================

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# git-delta
# =============================================================================

RUN ARCH=$(dpkg --print-architecture) \
    && DELTA_VERSION=$(curl -s https://api.github.com/repos/dandavison/delta/releases/latest | jq -r .tag_name) \
    && curl -fsSL "https://github.com/dandavison/delta/releases/download/${DELTA_VERSION}/git-delta_${DELTA_VERSION}_${ARCH}.deb" -o /tmp/delta.deb \
    && dpkg -i /tmp/delta.deb \
    && rm /tmp/delta.deb

# =============================================================================
# fzf
# =============================================================================

RUN git clone --depth 1 https://github.com/junegunn/fzf.git /opt/fzf \
    && /opt/fzf/install --all --no-bash --no-fish --no-update-rc

# =============================================================================
# Node.js LTS
# =============================================================================

RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g npm@latest \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# uv (Python package manager)
# =============================================================================

USER ${USERNAME}
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# =============================================================================
# Bun (JavaScript/TypeScript runtime)
# =============================================================================

USER ${USERNAME}
RUN curl -fsSL https://bun.sh/install | bash

# =============================================================================
# Non-root User
# =============================================================================

RUN groupadd --gid ${USER_GID} ${USERNAME} \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/zsh ${USERNAME} \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

# Set up user directories
RUN mkdir -p /home/${USERNAME}/.local/bin \
    && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}

# =============================================================================
# Oh My Zsh and Plugins (as user)
# =============================================================================

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# Install Oh My Zsh
RUN sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)" "" --unattended

# Install Powerlevel10k
RUN git clone --depth=1 https://github.com/romkatv/powerlevel10k.git \
    ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/themes/powerlevel10k

# Install zsh-autosuggestions
RUN git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions \
    ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-autosuggestions

# Install zsh-syntax-highlighting
RUN git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting \
    ${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting

# =============================================================================
# Claude Code
# =============================================================================

RUN curl -fsSL https://claude.ai/install.sh | bash

# =============================================================================
# Shell Configuration
# =============================================================================

USER root

# Copy shared configuration files
COPY --chown=${USERNAME}:${USERNAME} shared/.p10k.zsh /home/${USERNAME}/.p10k.zsh
COPY --chown=${USERNAME}:${USERNAME} shared/shell-setup.sh /home/${USERNAME}/.shell-setup.sh

USER ${USERNAME}

# Configure .zshrc
RUN cat >> ~/.zshrc << 'EOF'

# Powerlevel10k instant prompt
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Theme
ZSH_THEME="powerlevel10k/powerlevel10k"

# Plugins
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf
)

# Source shared shell setup
[[ -f ~/.shell-setup.sh ]] && source ~/.shell-setup.sh

# Source p10k config
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
EOF

# Configure git to use delta
RUN git config --global core.pager delta \
    && git config --global interactive.diffFilter "delta --color-only" \
    && git config --global delta.navigate true \
    && git config --global delta.side-by-side true

# =============================================================================
# Init Scripts
# =============================================================================

# init-speckit.sh, init-serena-mcp.sh はワークスペースにあるため
# コンテナ内から /workspace/.devcontainer/*.sh で実行可能

# =============================================================================
# Final Setup
# =============================================================================

USER ${USERNAME}
WORKDIR /workspace

# Default command
CMD ["zsh"]
