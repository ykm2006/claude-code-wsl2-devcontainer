#!/bin/bash
#
# code command wrapper
# Automatically detects the environment (WSL2 or native Linux) and sets up the correct
# devcontainer.json before launching VS Code.
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
DEVCONTAINER_DIR="$PROJECT_DIR/.devcontainer"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

# Execute setup-devcontainer.sh
log_info "Setting up devcontainer.json..."
bash "$SCRIPT_DIR/setup-devcontainer.sh"

if [ $? -ne 0 ]; then
  log_error "Failed to set up devcontainer.json"
  exit 1
fi

# Call the actual code command with all arguments
log_info "Launching VS Code..."

# Find the actual VS Code command (excluding this script)
VSCODE_CMD=$(which -a code 2>/dev/null | grep -v "$SCRIPT_DIR/code" | head -1)

if [ -z "$VSCODE_CMD" ] || [ ! -x "$VSCODE_CMD" ]; then
  log_error "VS Code not found in PATH"
  exit 1
fi

exec "$VSCODE_CMD" "$@"
