#!/bin/bash
#
# code command wrapper
# Automatically detects the environment (WSL2 or native Linux) and sets up the correct
# devcontainer.json symlink before launching VS Code.
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
DEVCONTAINER_DIR="$PROJECT_DIR/.devcontainer"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Helper functions
log_info() {
  echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
  echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
  echo -e "${RED}[ERROR]${NC} $1"
}

# Execute setup-devcontainer-symlink.sh
log_info "Setting up devcontainer.json symlink..."
bash "$SCRIPT_DIR/setup-devcontainer-symlink.sh"

if [ $? -ne 0 ]; then
  log_error "Failed to set up devcontainer.json symlink"
  exit 1
fi

log_info "Launching VS Code..."

# Call the actual code command with all arguments
/usr/bin/code "$@"
